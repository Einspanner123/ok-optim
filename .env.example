# ok-optim-agent 外层配置模板（复制为 .env 使用；.env 已 gitignore）
#
# 白名单机制：仅下列键会进入 agent 子进程环境（agent/envguard.py CONFIG_KEYS），
# 其余 .env 键一律不透传。任务参数用 --set KEY=VALUE 注入（无需写进 .env）。

# ── LLM endpoint（OpenAI 兼容）────────────────────────────────
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=sk-xxxx
AGENT_LLM_MODEL=your-model-id

# ── 模型解码参数（可选；未设置回落代码默认值；单次覆盖用 --set）──
# 核心参数：始终发送
# DECODE_TEMPERATURE=0.4         # 0.0–2.0；0 贪心在长会话会重复退化，勿回退
# DECODE_TOP_P=0.95              # 0.0–1.0
# DECODE_FREQUENCY_PENALTY=0.3   # -2.0–2.0；vLLM 专属字段，专治重复 token
# DECODE_MAX_TOKENS=16384        # 64–200000；pi maxTokens
# 扩展参数：仅显式设置时才发送（未设置 = 端点默认）
# DECODE_SEED=42                 # ≥0；设置后同输入同输出（确定性复现）
# DECODE_TOP_K=                  # ≥-1；-1 关闭截断
# DECODE_MIN_P=                  # 0.0–1.0；比 top_p 更稳的截断方式
# DECODE_PRESENCE_PENALTY=       # -2.0–2.0；按是否出现过惩罚（治重复）
# DECODE_REPETITION_PENALTY=     # 0.1–2.0；乘性惩罚（治重复另一路径）

# ── 网络（GitHub 等需要代理时）──────────────────────────────
# ALL_PROXY=socks5h://127.0.0.1:7890
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# ── ingest 检索/取证 ────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxx           # gh api 认证（probe 通道必需；只读 public 仓库权限即可）
# EMAIL=you@example.com          # Unpaywall API 必填参数（不发邮件、无需注册）

# ── optimize 任务（NPU 验证子进程，Python 3.10 + torch_npu）──
# NPU_PYTHON=/work/nvidia_ascend/.venv/bin/python

# ok-optim-agent 外层配置模板（复制为 .env 使用；.env 已 gitignore）

# LLM endpoint（OpenAI 兼容）
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=sk-xxxx
AGENT_LLM_MODEL=your-model-id

# optimize 任务: NPU 验证子进程（Python 3.10 + torch_npu）
# NPU_PYTHON=/work/nvidia_ascend/.venv/bin/python

# ingest 检索/取证
# GITHUB_TOKEN=ghp_xxx        # gh api 认证（probe 通道必需；只读 public 仓库权限即可）
# EMAIL=you@example.com       # Unpaywall API 必填参数（不发邮件、无需注册）

# 网络（GitHub 等需要代理时）
# ALL_PROXY=socks5h://127.0.0.1:7890
